   "source": [
    "#### Analyze Average of ROI"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 166,
   "id": "c0f2d0f3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Guinier fit results for <bioxtasraw.SASM.SASM object at 0x326347450>\n",
      "i0: 5.291e+00 ± 1.857e-02\n",
      "Rg: 3.134e+01 ± 1.542e-01\n",
      "Guinier fit R²: 0.8867\n",
      "Guinier range: q = 5.000e-03 to 4.200e-02\n",
      "Guinier range used Rg: q = 1.567e-01 to 1.316e+00\n",
      "idx_min: 0, idx_max: 37\n"
     ]
    }
   ],
   "source": [
    "#Automatically calculate the Guinier range and fit\n",
    "(rg, i0, rg_err, i0_err, qmin, qmax, qrg_min, qrg_max, idx_min, idx_max,\n",
    "    r_sq) = raw.auto_guinier(average_profile, settings=my_settings)\n",
    "\n",
    "print(f\"Guinier fit results for {average_profile}\")\n",
    "print(f\"i0: {i0:.3e} ± {i0_err:.3e}\")\n",
    "print(f\"Rg: {rg:.3e} ± {rg_err:.3e}\")\n",
    "print(f\"Guinier fit R²: {r_sq:.4f}\")\n",
    "print(f\"Guinier range: q = {qmin:.3e} to {qmax:.3e}\")\n",
    "print(f\"Guinier range used Rg: q = {qrg_min:.3e} to {qrg_max:.3e}\")\n",
    "print(f\"idx_min: {idx_min}, idx_max: {idx_max}\")"
   ]
  },
