   "outputs": [],
   "source": [
    "FOI = int(178)  # Frame of Interest, zero indexed\n",
    "\n",
    "profiles_roi = my_series.getSASMList(FOI, FOI)\n",
    "sub_profiles_roi = my_series.getSASMList(FOI, FOI, 'baseline')\n",
    "\n",
    "FOI_profile = sub_profiles_roi[0]\n",
    "\n",
