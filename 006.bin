   "cell_type": "code",
   "execution_count": 167,
   "id": "d1b39a81",
   "metadata": {},
   "outputs": [],
   "source": [
    "# AverageProfile \n",
    "q=average_profile.getQ()\n",
    "intensity = average_profile.getI()\n",
    "error = average_profile.getErr()"
   ]
  },
