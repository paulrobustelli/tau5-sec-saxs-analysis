    "print(rg_values)\n",
    "\n",
    "# Plot Rg values in histogram\n",
    "fig.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# histogram of Rg values (ignore NaNs)\n",
    "valid = ~np.isnan(rg_values)\n",
