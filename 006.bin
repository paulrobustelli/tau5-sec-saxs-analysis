  {
   "cell_type": "code",
   "execution_count": 143,
   "id": "b1c882dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Zoom in start frame and end frame for analysis\n",
    "# Zoom into the ROI\n",
    "start_frame = 100\n",
    "end_frame = 250"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 144,
   "id": "d4ad6352",
