   "metadata": {},
   "source": [
    "### WT Profiles"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 97,
   "id": "0de654f3",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Text(0, 0.5, 'Intensity (I)')"
      ]
     },
     "execution_count": 97,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 960x720 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Example of accessing a specific profile by frame number\n",
    "frame_number = \"175\"\n",
    "\n",
    "profile = WT_092025_profiles[frame_number]\n",
    "q = profile.getQ()\n",
    "I = profile.getI()\n",
    "err = profile.getErr()\n",
    "\n",
    "plt.figure(figsize=(8,6), dpi=120)\n",
    "plt.title(f'WT Profile of Frame {frame_number}')\n",
    "plt.plot(q, I, linestyle='-', marker=None)\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.xlabel('q (1/Å)')\n",
    "plt.ylabel('Intensity (I)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "d0221edc",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Plot Sub-profiles\n",
    "\n",
    "#plt.figure(figsize=(8, 6))\n",
    "plt.figure()\n",
    "\n",
    "n = len(WT_092025_profiles)\n",
    "cmap = plt.cm.plasma  # yellow → purple\n",
    "\n",
    "for i, (frame, profile) in enumerate(WT_092025_profiles.items()):\n",
    "\n",
    "    q = profile.getQ()\n",
    "    intensity = profile.getI()\n",
    "    error = profile.getErr()\n",
    "\n",
    "    # Normalize index to [0,1] for colormap\n",
    "    color = cmap(i / max(1, n - 1))\n",
    "\n",
    "    plt.plot(\n",
    "        q,\n",
    "        intensity,\n",
    "        color=color,\n",
    "        alpha=0.6,\n",
    "        linewidth=1,\n",
    "        label=f'Frame {frame}'\n",
    "    )\n",
    "\n",
    "frame_numbers = list(WT_092025_profiles.keys())\n",
    "first_frame = frame_numbers[0]\n",
    "last_frame = frame_numbers[-1]\n",
    "plt.title(f'WT 092025 Profiles: Frames {first_frame} to {last_frame}')\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.xlabel('q (1/Å)')\n",
    "plt.ylabel('Intensity')\n",
    "plt.xlim(0.005, 0.5)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
