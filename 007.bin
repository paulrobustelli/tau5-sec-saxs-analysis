   "source": [
    "## Scattering Plot of Individual Profiles"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 105,
   "id": "cc2248a2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
