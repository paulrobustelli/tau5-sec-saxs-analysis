   "source": [
    "## Dimensionless Kratky Plots of Average Profiles\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 58,
   "id": "311a7ef7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
