   ]
  },
  {
   "cell_type": "markdown",
   "id": "b8bb3811",
   "metadata": {},
   "source": [
    "# Read .dat files folder and store in dictionary to analyze"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "b35df797",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_profiles_by_frame(folder):\n",
    "    \"\"\"\n",
    "    Load all .dat profiles in a folder into a dictionary keyed by\n",
    "    the trailing frame number in the filename.\n",
    "\n",
    "    Example\n",
    "    -------\n",
    "    profile_175.dat -> profiles[\"175\"]\n",
    "    \"\"\"\n",
    "\n",
    "    folder = Path(folder)\n",
    "\n",
    "    profile_paths = sorted(\n",
    "        folder.glob(\"*.dat\"),\n",
    "        key=lambda p: int(re.search(r'(\\d+)$', p.stem).group(1))\n",
    "    )\n",
    "\n",
    "    profile_names = [str(p.resolve()) for p in profile_paths]\n",
    "    loaded_profiles = raw.load_profiles(profile_names)\n",
    "\n",
    "    profiles = {}\n",
    "\n",
    "    for path, profile in zip(profile_paths, loaded_profiles):\n",
    "        frame = re.search(r'(\\d+)$', path.stem).group(1)\n",
    "        profiles[frame] = profile\n",
    "\n",
    "    return profiles"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "467bd179",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load profiles into a dictionary keyed by frame number\n",
    "# Load all .dat files from the WT_092025 folder into a dictionary keyed by frame number\n",
    "WT_092025_profiles = load_profiles_by_frame(\"./dat_files/WT_092025\")"
   ]
  },
  {
   "cell_type": "code",
