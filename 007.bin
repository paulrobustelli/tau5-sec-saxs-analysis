    "# Load profiles into a dictionary keyed by frame number\n",
    "# Load all .dat files from the AA_052026 folder into a dictionary keyed by frame number\n",
    "AA_052026_profiles = load_profiles_by_frame(\"./dat_files/AA_052026\")"
   ]
  },
