    "# extended guinier loop\n",
    "\n",
    "results = []\n",
    "\n",
    "for profile in sub_profiles_roi:\n",
    "\n",
    "    eg = ExtendedGuinier(\n",
    "        profile.getQ(),\n",
    "        profile.getI(),\n",
    "        profile.getErr()\n",
    "    )\n",
    "\n",
    "    results.append(\n",
    "        eg.analyze(Nres=121)\n",
    "    )"
   ]
