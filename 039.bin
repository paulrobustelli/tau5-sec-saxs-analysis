    "\n",
    "            sub_profiles_roi = my_series.getSASMList(roi_start, roi_end, 'sub')\n",
    "\n",
    "            color = cmap(norm(k))\n",
    "            span_z = m - k\n",
    "            ax_bg.axvspan(roi_start, roi_end, color=color, alpha=0.25, zorder=span_z)\n",
    "\n",
