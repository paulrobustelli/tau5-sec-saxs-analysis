    "### Average Profiles "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "799587dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define a region of interest (ROI) for analysis, zero indexed\n",
    "roi_start = int(330)\n",
    "roi_end = int(340)\n",
    "\n",
    "#Get profiles from the series in a given range, zero indexed\n",
    "profiles_roi = my_series.getSASMList(roi_start, roi_end)\n",
    "sub_profiles_roi = my_series.getSASMList(roi_start, roi_end, 'baseline')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "ed6ea542",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<bioxtasraw.SASM.SASM at 0x327572f50>"
      ]
     },
     "execution_count": 47,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
