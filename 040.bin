   "source": [
    "#### if only buffer subtraction is done"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "a632d317",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Buffer range found: True, start: 182, end: 237\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "/opt/anaconda3/envs/RAW/lib/python3.14/site-packages/bioxtasraw/SASCalc.py:258: RuntimeWarning: invalid value encountered in log10\n",
      "  iratio = np.abs(np.log10(i0/i) - 2.25)\n"
     ]
    }
   ],
   "source": [
    "#Set buffer range\n",
    "success, region_start, region_end = raw.find_buffer_range(my_series)\n",
    "print(f\"Buffer range found: {success}, start: {region_start}, end: {region_end}\")\n",
    "    \n",
    "(sub_profiles, rg, rger, i0, i0er, vcmw, vcmwer,\n",
    "    vpmw) = raw.set_buffer_range(my_series, [[region_start, region_end]])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "9a9f87ad",
   "metadata": {},
   "outputs": [
    {
