   "outputs": [],
   "source": [
    "# Define a LARGE region of interest (ROI) for analysis with centerframe and step range\n",
    "range_int =int(30)\n",
    "centerframe_int= int(roi_start)\n",
    "step_range_int = int(20)\n",
    "\n",
    "rg_lower_limit = int(15)\n",
    "rg_upper_limit = int(40)"
   ]
  },
