   "source": [
    "# Set UP\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fcac5ecb",
   "metadata": {},
   "source": [
    "## Importing the BioXTAS API\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0e70182d",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "WARNING:silx.opencl.common:The module pyOpenCL has been imported but can't be used here\n"
     ]
    }
   ],
   "source": [
    "import bioxtasraw.RAWAPI as raw\n",
    "import bioxtasraw.RAWPlot as RAWPlot\n",
    "import bioxtasraw.SASCalc as SASCalc\n",
    "\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "\n",
    "import glob\n",
    "import os\n",
    "\n",
    "from pptx import Presentation\n",
    "from pptx.util import Inches\n",
    "import tempfile\n",
    "\n",
    "import imageio.v2 as imageio\n",
    "import math\n",
    "\n",
    "from scipy import optimize\n",
    "from scipy import special\n",
    "\n",
    "\n",
    "\n",
    "colorAA = 'orangered'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "47c5ba35",
   "metadata": {},
   "outputs": [],
   "source": [
    "AA_hdf5='./data/AA_052024.hdf5'\n",
    "\n"
   ]
  },
