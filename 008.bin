   "source": [
    "### Average Profiles "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "799587dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define a region of interest (ROI) for analysis, zero indexed\n",
    "roi_start = int(162)\n",
    "roi_end = int(173)\n",
    "\n",
    "#Get profiles from the series in a given range, zero indexed\n",
    "profiles_roi = my_series.getSASMList(roi_start, roi_end)\n",
    "sub_profiles_roi = my_series.getSASMList(roi_start, roi_end, 'sub')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "ed6ea542",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<bioxtasraw.SASM.SASM at 0x31ef22850>"
      ]
     },
     "execution_count": 34,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "average_profile = raw.average(sub_profiles_roi[:])\n",
    "average_profile"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "7bbc75c7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# AverageProfile \n",
    "q_avg=average_profile.getQ()\n",
    "intensity_avg=average_profile.getI()\n",
    "error_avg=average_profile.getErr()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "aa291846",
   "metadata": {},
   "outputs": [
