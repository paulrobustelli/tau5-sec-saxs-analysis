     "text": [
      "/var/folders/pd/1zdq_nrd781b0d2ptzzg9_tr0000gp/T/ipykernel_24244/3690464081.py:11: RuntimeWarning: invalid value encountered in log\n",
      "  I_ln = np.log(intensity)\n"
     ]
