      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Average curve\n",
    "plt.Figure(figsize=(8,6), dpi=120)\n",
    "plt.plot(q_avg, intensity_avg, linestyle='-', marker=None)\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.xlabel('q (1/Å)')\n",
    "plt.ylabel('Intensity (I)')\n"
   ]
  },
  {
   "cell_type": "code",
