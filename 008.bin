      "\u001b[36mFile \u001b[39m\u001b[32m/opt/anaconda3/envs/RAW/lib/python3.14/site-packages/matplotlib/axes/_axes.py:3825\u001b[39m, in \u001b[36mAxes.errorbar\u001b[39m\u001b[34m(self, x, y, yerr, xerr, fmt, ecolor, elinewidth, capsize, barsabove, lolims, uplims, xlolims, xuplims, errorevery, capthick, **kwargs)\u001b[39m\n\u001b[32m   3819\u001b[39m \u001b[38;5;66;03m# Raise if any errors are negative, but not if they are nan.\u001b[39;00m\n\u001b[32m   3820\u001b[39m \u001b[38;5;66;03m# To avoid nan comparisons (which lead to warnings on some\u001b[39;00m\n\u001b[32m   3821\u001b[39m \u001b[38;5;66;03m# platforms), we select with `err==err` (which is False for nan).\u001b[39;00m\n\u001b[32m   3822\u001b[39m \u001b[38;5;66;03m# Also, since datetime.timedelta cannot be compared with 0,\u001b[39;00m\n\u001b[32m   3823\u001b[39m \u001b[38;5;66;03m# we compare with the negative error instead.\u001b[39;00m\n\u001b[32m   3824\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m np.any((check := err[err == err]) < -check):\n\u001b[32m-> \u001b[39m\u001b[32m3825\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mValueError\u001b[39;00m(\n\u001b[32m   3826\u001b[39m         \u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33m'\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mdep_axis\u001b[38;5;132;01m}\u001b[39;00m\u001b[33merr\u001b[39m\u001b[33m'\u001b[39m\u001b[33m must not contain negative values\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m   3827\u001b[39m \u001b[38;5;66;03m# This is like\u001b[39;00m\n\u001b[32m   3828\u001b[39m \u001b[38;5;66;03m#     elow, ehigh = np.broadcast_to(...)\u001b[39;00m\n\u001b[32m   3829\u001b[39m \u001b[38;5;66;03m#     return dep - elow * ~lolims, dep + ehigh * ~uplims\u001b[39;00m\n\u001b[32m   3830\u001b[39m \u001b[38;5;66;03m# except that broadcast_to would strip units.\u001b[39;00m\n\u001b[32m   3831\u001b[39m low, high = dep + np.vstack([-(\u001b[32m1\u001b[39m - lolims), \u001b[32m1\u001b[39m - uplims]) * err\n",
      "\u001b[31mValueError\u001b[39m: 'yerr' must not contain negative values"
