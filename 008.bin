    "log_Iq = result[\"log_Iq\"]\n",
    "log_Iq_fit = result[\"log_Iq_fit\"]\n",
    "residuals = result [\"residuals\"]\n",
    "I0 = result[\"I0\"]\n",
    "print(qrange)\n",
    "\n"
   ]
