   "source": [
    "# Define a region of interest (ROI) for analysis, zero indexed\n",
    "roi_start = int(163)\n",
    "roi_end = int(168)\n",
    "\n",
    "#Get profiles from the series in a given range, zero indexed\n",
    "profiles_roi = my_series.getSASMList(roi_start, roi_end)\n",
    "sub_profiles_roi = my_series.getSASMList(roi_start, roi_end, 'sub')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 528,
   "id": "7ba96294",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<matplotlib.legend.Legend at 0x12000c1a0>"
      ]
     },
     "execution_count": 528,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Plot Sub-profiles\n",
    "plt.figure()\n",
    "\n",
    "n = len(sub_profiles_roi)\n",
    "cmap = plt.cm.plasma  # yellow → purple\n",
    "\n",
    "for i in range(len(sub_profiles_roi)):\n",
    "    profile_n = sub_profiles_roi[i]\n",
    "\n",
    "    q = profile_n.getQ()\n",
    "    intensity = profile_n.getI()\n",
    "    error = profile_n.getErr()\n",
    "\n",
    "    # Normalize index to [0,1] for colormap\n",
    "    color = cmap(i / (n - 1))\n",
    "\n",
    "    # Plot individual curves\n",
    "    plt.plot(q, intensity, color=color, alpha=0.6, linewidth=1, label=f'Frame {roi_start + i}')\n",
    "\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.xlabel('q (1/Å)')\n",
    "plt.ylabel('Intensity (I)')\n",
    "plt.xlim(0.005, 0.5)\n",
    "plt.legend()\n"
   ]
  },
