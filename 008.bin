   ],
   "source": [
    "FOI = int(165)  # Frame of Interest, zero indexed\n",
    "\n",
    "profile = profiles_roi = my_series.getSASMList(FOI, FOI)\n",
    "sub_profiles_roi = my_series.getSASMList(FOI, FOI, 'sub')\n",
    "\n",
    "FOI_profile = sub_profiles_roi[0]\n",
    "FOI_profile"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "12a19e95",
   "metadata": {},
   "outputs": [
    {
     "data": {
